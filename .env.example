# Copy this file to .env and fill in your values
# Windows: copy .env.example .env

# -----------------------------------------------------------------------
# PostgreSQL (local)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/luffy_db

# -----------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------
# Phase 1 - Free APIs
# -----------------------------------------------------------------------

# Google Custom Search API — 100 free searches/day
# Step 1: Go to https://programmablesearchengine.google.com → Create a search engine
#         Set "Search the entire web" = ON → Copy the Search Engine ID below
# Step 2: Go to https://console.cloud.google.com → Enable "Custom Search API"
#         Create credentials → API Key → Copy below
GOOGLE_CSE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_search_engine_id_here

# Playwright — no API key needed, runs locally (already in requirements.txt)

# -----------------------------------------------------------------------
# Phase 2 - APIs (free trials available)
# -----------------------------------------------------------------------

# SerpAPI — Google search without daily cap
# Free trial: 100 searches/month — https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# ProxyCurl — LinkedIn profile data (legal API)
# Free trial: 10 credits on signup — https://nubela.co/proxycurl
PROXYCURL_API_KEY=your_proxycurl_key_here

# Hunter.io — find professional email addresses
# Free plan: 25 searches/month — https://hunter.io
HUNTER_API_KEY=your_hunter_api_key_here

# -----------------------------------------------------------------------
# Phase 3 - Authorized LinkedIn Extraction Operational Limits
# -----------------------------------------------------------------------
LINKEDIN_PROVIDER=authorized
MAX_PROFILES_PER_SESSION=25
MAX_SESSION_DURATION_MINUTES=30
PAGE_LOAD_TIMEOUT=45000
ELEMENT_TIMEOUT=10000
MAX_EXTRACTION_RETRIES=3
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_password
# SignalHire REST API Integration for Phone & Email Enrichment
# Provide a single key OR comma-separated list of keys for automatic failover/rotation when credits expire
# e.g.: SIGNALHIRE_API_KEY=key1,key2,key3
SIGNALHIRE_API_KEY=your_signalhire_api_key_here
# Alternatively:
# SIGNALHIRE_API_KEYS=key1,key2,key3
# SignalHire Webhook Callback URL (defaults to placeholder if no custom server/ngrok is used)
SIGNALHIRE_CALLBACK_URL=https://example.com/signalhire-callback

# -----------------------------------------------------------------------
# Database Persistence (PostgreSQL / SQLite for Eligible Candidates)
# -----------------------------------------------------------------------
DATABASE_ENABLED=false
# Cloud PostgreSQL (e.g. Neon.tech, Supabase, AWS RDS):
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:admin123@localhost:5432/candidates_db
# Local SQLite fallback:
# DATABASE_URL=sqlite:///skills/output/candidates.db

